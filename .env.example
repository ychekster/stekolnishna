# Copy to .env.local and fill in. Never commit real values.

# Extra hosts allowed to call the app (dev assets + Server Actions), comma-separated.
# Needed when opening the site through a tunnel or proxy, e.g. Cloudflare quick tunnel:
ALLOWED_ORIGINS=*.trycloudflare.com

# Public address of the site, for absolute URLs in link previews (Open Graph), e.g.
# https://steklo-center.kz. Leave empty until the domain is known.
SITE_URL=
